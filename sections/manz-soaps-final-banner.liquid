{%- liquid
  assign final_image = section.settings.background_image
  assign final_url = section.settings.button_link | default: routes.all_products_collection_url
-%}

{%- if collection.handle == 'body' or template.suffix == 'sabonetes' -%}
<section class="manz-soaps-final" aria-labelledby="ManzSoapsFinalTitle-{{ section.id }}">
  <div class="manz-soaps-final__media">
    {%- if final_image != blank -%}
      {{ final_image | image_url: width: 3000 | image_tag:
        class: 'manz-soaps-final__image',
        widths: '960, 1440, 1920, 2400, 3000',
        sizes: '100vw',
        loading: 'lazy',
        decoding: 'async',
        alt: final_image.alt | default: 'Sabonete artesanal sobre pedra natural junto ao mar'
      }}
    {%- elsif section.settings.show_theme_fallback -%}
      <img
        class="manz-soaps-final__image"
        src="{{ 'manz-soap-product-red-clay.jpg' | asset_url }}"
        sizes="(min-width: 750px) 60vw, 100vw"
        width="1086"
        height="1448"
        alt="Sabonete artesanal sobre pedra natural junto ao mar"
        loading="lazy"
        decoding="async"
      >
    {%- else -%}
      <div class="manz-soaps-final__image-placeholder" aria-hidden="true"></div>
    {%- endif -%}
    <div class="manz-soaps-final__shade" aria-hidden="true"></div>
  </div>
  <div class="manz-soaps-final__content page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="manz-soaps__eyebrow manz-soaps__eyebrow--final">{{ section.settings.eyebrow | escape }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="manz-soaps-final__heading" id="ManzSoapsFinalTitle-{{ section.id }}">
        {{ section.settings.heading | escape | newline_to_br }}
      </h2>
    {%- endif -%}
    {%- if section.settings.copy != blank -%}
      <p class="manz-soaps-final__copy">{{ section.settings.copy | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank and final_url != blank -%}
      <a class="manz-soaps-final__button" href="{{ final_url | escape }}">
        {{ section.settings.button_label | escape }} <span aria-hidden="true">→</span>
      </a>
    {%- endif -%}
  </div>
</section>
{%- endif -%}

{% schema %}
{
  "name": "Fecho sabonetes",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Fotografia de encerramento",
      "info": "A imagem escolhida substitui a foto de campanha original usada pelo tema como padrão."
    },
    {
      "type": "checkbox",
      "id": "show_theme_fallback",
      "label": "Usar a foto de campanha original se a imagem estiver vazia",
      "info": "Desative para deixar a área sem fotografia quando o seletor estiver vazio.",
      "default": true
    },
    { "type": "text", "id": "eyebrow", "label": "Identificador", "default": "MANZ SKIN" },
    {
      "type": "textarea",
      "id": "heading",
      "label": "Título",
      "default": "Natureza, beleza\ne autenticidade."
    },
    {
      "type": "textarea",
      "id": "copy",
      "label": "Texto",
      "default": "Nossos sabonetes unem o poder dos ingredientes naturais ao cuidado artesanal, em uma rotina de autocuidado mais simples, consciente e real."
    },
    { "type": "text", "id": "button_label", "label": "Texto do botão", "default": "Ver todos os produtos" },
    { "type": "url", "id": "button_link", "label": "Link do botão", "info": "Se ficar vazio, o botão abre a página de todos os produtos." }
  ],
  "presets": [
    { "name": "Fecho sabonetes" }
  ]
}
{% endschema %}
