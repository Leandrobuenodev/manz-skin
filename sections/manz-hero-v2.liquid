{% comment %}
  Editor-configurable homepage Hero. It retains the existing homepage section
  instance and slide block settings while rendering the V2 composition.
{% endcomment %}
{%- liquid
  assign desktop_slides = section.blocks | where: 'type', 'slide'
  assign mobile_slides = section.blocks | where: 'type', 'mobile_slide'
  assign desktop_viewport_id = 'ManzHeroCarouselDesktop-' | append: section.id
  assign mobile_viewport_id = 'ManzHeroCarouselMobile-' | append: section.id
-%}
<manz-hero
  class="manz-hero-shell manz-hero-v2-shell"
  data-manz-hero
  data-manz-hero-v2
  data-manz-carousel
  data-manz-carousel-interval="{{ section.settings.carousel_interval | default: 5 | times: 1000 }}"
  data-manz-carousel-duration="800"
  style="--manz-hero-v2-frame-width: {{ section.settings.frame_width }}vw; --manz-hero-v2-frame-height: 60vw; --manz-hero-v2-panel-bottom-gap: calc((100svh - min(var(--manz-hero-v2-frame-height), 93.333svh)) / 2); --manz-hero-v2-radius: {{ section.settings.frame_radius }}px; --manz-hero-v2-background-x: {{ section.settings.background_focus_x }}%; --manz-hero-v2-background-y: {{ section.settings.background_focus_y }}%; --manz-hero-v2-portrait-x: {{ section.settings.portrait_focus_x }}%; --manz-hero-v2-portrait-y: {{ section.settings.portrait_focus_y }}%; --manz-hero-v2-portrait-mobile-x: {{ section.settings.portrait_mobile_focus_x }}%; --manz-hero-v2-portrait-mobile-y: {{ section.settings.portrait_mobile_focus_y }}%;"
>
  <div class="manz-hero-v2" aria-labelledby="ManzHeroV2Title-{{ section.id }}">
    <div class="manz-hero-v2__background" aria-hidden="true">
      {%- if section.settings.background_image != blank -%}
        {{ section.settings.background_image | image_url: width: 2880 | image_tag:
          class: 'manz-hero-v2__background-image',
          widths: '960, 1440, 1920, 2400, 2880',
          sizes: '100vw',
          loading: 'eager',
          fetchpriority: 'high',
          alt: ''
        }}
      {%- elsif section.settings.show_fallback_background -%}
        <picture class="manz-hero-v2__background-picture">
          <source srcset="{{ 'manz-home-hero-background.webp' | asset_url }}" type="image/webp">
          <img
            class="manz-hero-v2__background-image"
            src="{{ 'manz-home-hero-background.png' | asset_url }}"
            width="1672"
            height="941"
            alt=""
            loading="eager"
            fetchpriority="high"
          >
        </picture>
      {%- endif -%}
    </div>

    <div class="manz-hero-v2__panel" id="ManzHeroCarouselRoot-{{ section.id }}" {% if mobile_slides.size > 0 %}data-manz-has-mobile-view{% endif %}>
      <div class="manz-hero-v2__view manz-hero-v2__view--desktop" data-manz-carousel-view="desktop">
        {% render 'manz-hero-carousel', hero_section: section, slides: desktop_slides, view_mode: 'desktop', viewport_id: desktop_viewport_id, version: 'v2', sizes: '(min-width: 750px) 94vw, 100vw', legacy_image: section.settings.portrait_image, legacy_mobile_image: section.settings.mobile_portrait_image, legacy_alt: section.settings.portrait_alt %}
      </div>
      {%- if mobile_slides.size > 0 -%}
        <div class="manz-hero-v2__view manz-hero-v2__view--mobile" data-manz-carousel-view="mobile">
          {% render 'manz-hero-carousel', hero_section: section, slides: mobile_slides, view_mode: 'mobile', viewport_id: mobile_viewport_id, version: 'v2', sizes: '100vw' %}
        </div>
      {%- endif -%}
      {%- if section.blocks.size > 1 -%}
        <button class="manz-hero-v2__carousel-control manz-hero-v2__carousel-control--previous" type="button" data-manz-carousel-previous aria-label="Fotografia anterior" aria-controls="ManzHeroCarouselRoot-{{ section.id }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m14.5 5-7 7 7 7" /></svg>
        </button>
        <button class="manz-hero-v2__carousel-control manz-hero-v2__carousel-control--next" type="button" data-manz-carousel-next aria-label="Próxima fotografia" aria-controls="ManzHeroCarouselRoot-{{ section.id }}">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="m9.5 5 7 7-7 7" /></svg>
        </button>
      {%- endif -%}
    </div>

    <div class="manz-hero-v2__mobile-content">
      <div class="manz-hero__copy manz-hero-v2__copy">
        {%- if section.settings.eyebrow != blank -%}
          <p class="manz-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        <h1 id="ManzHeroV2Title-{{ section.id }}" class="manz-hero__title">
          <span class="manz-hero__line"><span class="manz-hero__line-inner">{{ section.settings.heading_line_one | escape }}</span></span>
          {%- if section.settings.heading_line_two != blank -%}
            <span class="manz-hero__line"><span class="manz-hero__line-inner">{{ section.settings.heading_line_two | escape }}</span></span>
          {%- endif -%}
        </h1>
        {%- if section.settings.caption != blank -%}
          <p class="manz-hero__caption">{{ section.settings.caption | escape }}</p>
        {%- endif -%}
      </div>
      {%- assign hero_cta_url = section.settings.cta_link | default: routes.all_products_collection_url -%}
      {%- if section.settings.cta_label != blank and hero_cta_url != blank -%}
        <a class="manz-hero-v2__cta" href="{{ hero_cta_url | escape }}">
          {{ section.settings.cta_label | escape }} <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
      {%- if mobile_slides.size > 0 -%}
        <div class="manz-hero-v2__carousel-indicators" data-manz-carousel-indicators role="group" aria-label="Selecionar fotografia da hero">
          {%- for slide in mobile_slides -%}
            <button
              class="manz-hero-v2__carousel-indicator"
              type="button"
              data-manz-carousel-indicator="{{ forloop.index0 }}"
              aria-label="Mostrar fotografia {{ forloop.index }} de {{ mobile_slides.size }}"
              aria-controls="{{ mobile_viewport_id }}"
              {% if forloop.first %}aria-current="true"{% endif %}
            ></button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

  </div>
  {% render 'manz-rock-transition', background_image: section.settings.background_image %}
</manz-hero>

{% schema %}
{
  "name": "Manz — Hero V2",
  "tag": "section",
  "class": "section-manz-hero-v2",
  "limit": 1,
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "image_picker", "id": "background_image", "label": "Fotografia de fundo" },
    { "type": "checkbox", "id": "show_fallback_background", "label": "Usar o fundo original do tema se a fotografia estiver vazia", "info": "Desative para deixar o fundo neutro quando nenhuma fotografia estiver escolhida.", "default": true },
    { "type": "image_picker", "id": "mobile_portrait_image", "label": "Fotografia mobile (legado)", "info": "Compatibilidade; nos blocos de slides, selecione a fotografia mobile correspondente." },
    { "type": "image_picker", "id": "portrait_image", "label": "Fotografia principal legada", "info": "Compatibilidade com configurações anteriores; use os blocos de slides para editar o carrossel." },
    { "type": "text", "id": "portrait_alt", "label": "Descrição da fotografia principal", "default": "Retrato das três mulheres à beira-mar na campanha Manz Skin" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeno", "default": "MANZ SKIN · NATURAL SKINCARE" },
    { "type": "text", "id": "heading_line_one", "label": "Título — primeira linha", "default": "Beyond the" },
    { "type": "text", "id": "heading_line_two", "label": "Título — segunda linha", "default": "Skin." },
    { "type": "text", "id": "caption", "label": "Texto complementar", "default": "Natureza, beleza e autenticidade." },
    { "type": "text", "id": "cta_label", "label": "Texto do botão", "default": "Ver todos os produtos" },
    { "type": "url", "id": "cta_link", "label": "Link do botão", "info": "Se ficar vazio, o botão abre a página de todos os produtos." },
    { "type": "range", "id": "carousel_interval", "label": "Intervalo do carrossel", "min": 2, "max": 15, "step": 1, "unit": "s", "default": 5 },
    { "type": "range", "id": "frame_width", "label": "Largura do painel — desktop", "min": 72, "max": 94, "step": 1, "unit": "%", "default": 94 },
    { "type": "range", "id": "frame_radius", "label": "Arredondamento do painel", "min": 6, "max": 24, "step": 1, "unit": "px", "default": 14 },
    { "type": "range", "id": "background_focus_x", "label": "Enquadramento horizontal — fundo", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "background_focus_y", "label": "Enquadramento vertical — fundo", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 52 },
    { "type": "range", "id": "portrait_focus_x", "label": "Enquadramento horizontal — painel", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "portrait_focus_y", "label": "Enquadramento vertical — painel", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "portrait_mobile_focus_x", "label": "Enquadramento horizontal — mobile", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "portrait_mobile_focus_y", "label": "Enquadramento vertical — mobile", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 45 },
    { "type": "checkbox", "id": "animate", "label": "Animação de entrada (legado)", "info": "Mantido para compatibilidade com configurações anteriores; as animações de entrada foram desativadas para estabilizar o carregamento.", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Foto do carrossel",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Fotografia" },
        { "type": "image_picker", "id": "mobile_image", "label": "Fotografia mobile (opcional)", "info": "Se ficar vazia, a fotografia principal sera adaptada ao recorte mobile." },
        { "type": "checkbox", "id": "use_theme_fallback", "label": "Usar a foto original deste slide se a fotografia estiver vazia", "info": "Desative para mostrar um espaço neutro quando não houver uma imagem escolhida.", "default": false },
        { "type": "text", "id": "alt", "label": "Descrição da fotografia", "default": "Fotografia da campanha Manz Skin" },
        { "type": "range", "id": "focus_x", "label": "Enquadramento horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "focus_y", "label": "Enquadramento vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "mobile_focus_x", "label": "Enquadramento horizontal — mobile", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "mobile_focus_y", "label": "Enquadramento vertical — mobile", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "select", "id": "image_fit", "label": "Ajuste da fotografia", "default": "cover", "options": [{ "value": "cover", "label": "Preencher painel" }, { "value": "contain", "label": "Mostrar fotografia inteira" }] }
      ]
    },
    {
      "type": "mobile_slide",
      "name": "Foto mobile",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Fotografia mobile" },
        { "type": "select", "id": "fallback_asset", "label": "Foto padrão deste slide", "info": "Usada se nenhuma fotografia do Theme Editor estiver selecionada.", "default": "dsc00712", "options": [
          { "value": "dsc00712", "label": "DSC00712 — Sabonetes e argilas" },
          { "value": "dsc00441", "label": "DSC00441 — Produto nos lábios" },
          { "value": "dsc00932", "label": "DSC00932 — Produtos em folhas verdes" },
          { "value": "dsc01903", "label": "DSC01903 — Sabonetes em pedra escura" },
          { "value": "dsc01954", "label": "DSC01954 — Corpos e sabonetes" },
          { "value": "dsc00785", "label": "DSC00785 — Modelo ruiva" }
        ] },
        { "type": "text", "id": "alt", "label": "Descrição da fotografia", "default": "Fotografia da campanha Manz Skin" },
        { "type": "range", "id": "focus_x", "label": "Enquadramento horizontal mobile", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "focus_y", "label": "Enquadramento vertical mobile", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "overlay_strength", "label": "Gradiente para leitura", "min": 0, "max": 70, "step": 5, "unit": "%", "default": 45 }
      ]
    }
  ],
  "max_blocks": 20,
  "presets": [{
    "name": "Manz — Hero V2",
    "blocks": [
      { "type": "slide", "settings": { "alt": "Retrato das três mulheres à beira-mar na campanha Manz Skin", "use_theme_fallback": true } },
      { "type": "slide", "settings": { "alt": "Modelo ruiva segurando um sabonete artesanal Manz Skin", "focus_x": 50, "focus_y": 40, "mobile_focus_x": 50, "mobile_focus_y": 50, "use_theme_fallback": true } },
      { "type": "slide", "settings": { "alt": "Três modelos com roupas de praia na campanha Manz Skin", "focus_x": 50, "focus_y": 50, "mobile_focus_x": 50, "mobile_focus_y": 50, "use_theme_fallback": true } },
      { "type": "slide", "settings": { "alt": "Sabonetes artesanais acompanhados de ingredientes naturais e argilas", "focus_x": 50, "focus_y": 52, "mobile_focus_x": 50, "mobile_focus_y": 50, "use_theme_fallback": true } }
    ]
  }]
}
{% endschema %}
