{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'manz-policy.css' | asset_url | stylesheet_tag }}

<main class="manz-policy page-width section-{{ section.id }}-padding">
  {%- if policy.title != blank -%}
    <p class="manz-policy__eyebrow">MANZ SKIN · INFORMAÇÕES</p>
    <h1 class="manz-policy__title">{{ policy.title | escape }}</h1>
  {%- endif -%}
  {%- if policy.body != blank -%}
    <div class="manz-policy__body rte">{{ policy.body }}</div>
  {%- endif -%}
</main>

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% schema %}
{
  "name": "Política Shopify",
  "tag": "section",
  "class": "section-manz-policy",
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento superior",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espaçamento inferior",
      "default": 48
    }
  ]
}
{% endschema %}
