{% comment %}Homepage-only editorial hero. Header remains the existing header section.{% endcomment %}
<manz-hero
  class="manz-hero-shell"
  data-manz-hero
  data-manz-carousel
  data-manz-carousel-interval="7000"
  data-manz-carousel-duration="800"
  style="--manz-hero-focus-x: {{ section.settings.focus_desktop }}%; --manz-hero-focus-mobile-x: {{ section.settings.focus_mobile }}%; --manz-hero-focus-y: {{ section.settings.focus_vertical }}%;"
>
  <div class="manz-hero" aria-labelledby="ManzHeroTitle-{{ section.id }}">
    {% render 'manz-hero-carousel', hero_section: section, version: 'v1', sizes: '(max-aspect-ratio: 3/2) 150svh, 100vw', legacy_image: section.settings.image, legacy_alt: section.settings.image_alt %}
    <div class="manz-hero__copy">
      {%- if section.settings.eyebrow != blank -%}
        <p class="manz-hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="ManzHeroTitle-{{ section.id }}" class="manz-hero__title">
        <span class="manz-hero__line"><span class="manz-hero__line-inner">{{ section.settings.heading_line_one | escape }}</span></span>
        {%- if section.settings.heading_line_two != blank -%}
          <span class="manz-hero__line"><span class="manz-hero__line-inner">{{ section.settings.heading_line_two | escape }}</span></span>
        {%- endif -%}
      </h1>
      {%- if section.settings.caption != blank -%}
        <p class="manz-hero__caption">{{ section.settings.caption | escape }}</p>
      {%- endif -%}
    </div>
    {%- if section.settings.cta_label != blank -%}
      {%- assign cta_link = section.settings.cta_link | default: routes.all_products_collection_url -%}
      <a class="manz-hero__cta" href="{{ cta_link | escape }}">
        {{ section.settings.cta_label | escape }} <span aria-hidden="true">→</span>
      </a>
    {%- endif -%}
  </div>
</manz-hero>

{% schema %}
{
  "name": "Manz — Hero V1",
  "tag": "section",
  "class": "section-manz-hero-v1",
  "limit": 1,
  "enabled_on": { "templates": ["index"] },
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Fotografia principal legada", "info": "Compatibilidade com configurações anteriores; use os blocos de slides para editar o carrossel." },
    { "type": "text", "id": "image_alt", "label": "Descrição da fotografia", "default": "Três modelos à beira-mar na campanha Manz Skin" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeno", "default": "MANZ SKIN · NATURAL SKINCARE" },
    { "type": "text", "id": "heading_line_one", "label": "Título — primeira linha", "default": "Beyond the" },
    { "type": "text", "id": "heading_line_two", "label": "Título — segunda linha", "default": "Skin." },
    { "type": "text", "id": "caption", "label": "Texto complementar", "default": "Natureza, beleza e autenticidade." },
    { "type": "text", "id": "cta_label", "label": "Texto do botão", "default": "Ver todos os produtos" },
    { "type": "url", "id": "cta_link", "label": "Link do botão", "info": "Se ficar vazio, o botão abre a página de todos os produtos." },
    { "type": "range", "id": "focus_desktop", "label": "Enquadramento horizontal — desktop", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "focus_mobile", "label": "Enquadramento horizontal — mobile", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "focus_vertical", "label": "Enquadramento vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
    { "type": "range", "id": "overlay", "label": "Gradiente nas bordas (legado)", "info": "Mantido para compatibilidade com configurações anteriores; não é aplicado nesta versão.", "min": 0, "max": 20, "step": 1, "unit": "%", "default": 5 },
    { "type": "checkbox", "id": "animate", "label": "Animação de entrada (legado)", "info": "Mantido para compatibilidade com configurações anteriores; as animações de entrada foram desativadas para estabilizar o carregamento.", "default": true }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Foto do carrossel",
      "limit": 8,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Fotografia" },
        { "type": "text", "id": "alt", "label": "Descrição da fotografia", "default": "Fotografia da campanha Manz Skin" },
        { "type": "range", "id": "focus_x", "label": "Enquadramento horizontal", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "focus_y", "label": "Enquadramento vertical", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "mobile_focus_x", "label": "Enquadramento horizontal — mobile", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "range", "id": "mobile_focus_y", "label": "Enquadramento vertical — mobile", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 50 },
        { "type": "select", "id": "image_fit", "label": "Ajuste da fotografia", "default": "cover", "options": [{ "value": "cover", "label": "Preencher painel" }, { "value": "contain", "label": "Mostrar fotografia inteira" }] }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [{
    "name": "Manz — Hero V1",
    "blocks": [
      { "type": "slide", "settings": { "alt": "Três modelos na praia ao entardecer, com luz dourada" } },
      { "type": "slide", "settings": { "alt": "Modelo ruiva segurando um sabonete artesanal Manz Skin", "focus_x": 50, "focus_y": 40, "mobile_focus_x": 50, "mobile_focus_y": 50 } },
      { "type": "slide", "settings": { "alt": "Três modelos com roupas de praia na campanha Manz Skin", "focus_x": 50, "focus_y": 50, "mobile_focus_x": 50, "mobile_focus_y": 50 } },
      { "type": "slide", "settings": { "alt": "Sabonetes artesanais acompanhados de ingredientes naturais e argilas", "focus_x": 50, "focus_y": 52, "mobile_focus_x": 50, "mobile_focus_y": 50 } }
    ]
  }]
}
{% endschema %}
