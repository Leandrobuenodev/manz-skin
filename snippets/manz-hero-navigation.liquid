<nav class="manz-hero-nav{% if mobile %} manz-hero-nav--mobile{% endif %}" aria-label="{% if mobile %}Navegação mobile{% else %}Navegação principal{% endif %}">
  {%- assign hero_home_link_handles = 'inicio,sabonetes,rastreamento-de-pedidos' | split: ',' -%}
  {%- for link in section.settings.menu.links -%}
    {%- assign hero_link_handle = link.title | handleize -%}
    {%- if request.page_type == 'index' -%}
      {%- if hero_home_link_handles contains hero_link_handle -%}
        <a class="manz-hero-nav__link" href="{{ link.url | escape }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
      {%- endif -%}
    {%- else -%}
      <a class="manz-hero-nav__link" href="{{ link.url | escape }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a>
    {%- endif -%}
  {%- endfor -%}
</nav>
